{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "debugLog": false,
  "permissionReviewLog": true,
  "yoloMode": false,
  "doublePressToConfirm": true,
  "promptNotifications": ["bell"],
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      ".git/*": "deny",
      ".git": "deny",
      "node_modules/*": "deny",
      "~/.ssh/*": "deny",
      "~/.aws/*": "deny",
      "~/.config/*/secrets*": "deny"
    },
    "external_directory": "allow",
    "bash": {
      "*": "allow",

      "rm *": "ask",
      "rm -rf*": "ask",
      "sudo rm*": "ask",
      "find * -delete": "ask",
      "find * -exec rm*": "ask",
      "shred *": "ask",
      "dd *": "ask",
      "mkfs*": "ask",
      "diskutil erase*": "ask",
      "diskutil partition*": "ask",
      "mv * /.git/*": "ask",
      "mv * /node_modules/*": "ask",
      "chmod 777*": "ask",
      "chmod -R 777*": "ask",
      "chown *": "ask",
      "chgrp *": "ask",

      "brew install*": "ask",
      "brew uninstall*": "ask",
      "brew upgrade*": "ask",
      "npm install*": "ask",
      "npm i *": "ask",
      "npm uninstall*": "ask",
      "npm remove*": "ask",
      "npm rm*": "ask",
      "npm -g install*": "ask",
      "npx *": "ask",
      "pnpm add*": "ask",
      "pnpm install*": "ask",
      "pnpm remove*": "ask",
      "yarn add*": "ask",
      "yarn install*": "ask",
      "yarn remove*": "ask",
      "yarn global add*": "ask",
      "pip install*": "ask",
      "pip3 install*": "ask",
      "pip uninstall*": "ask",
      "pip3 uninstall*": "ask",
      "pipx install*": "ask",
      "pipx uninstall*": "ask",
      "cargo install*": "ask",
      "cargo uninstall*": "ask",
      "go install*": "ask",
      "gem install*": "ask",
      "gem uninstall*": "ask",
      "apt install*": "ask",
      "apt-get install*": "ask",
      "apt remove*": "ask",
      "apt-get remove*": "ask",
      "dnf install*": "ask",
      "yum install*": "ask",
      "pacman -S*": "ask",

      "git push --force*": "ask",
      "git push -f*": "ask",
      "git reset --hard*": "ask",
      "git clean -fd*": "ask",
      "git branch -D*": "ask",
      "git tag -d*": "ask",
      "git rebase*": "ask",
      "git filter-branch*": "ask",

      "docker system prune*": "ask",
      "docker volume rm*": "ask",
      "docker container rm*": "ask",
      "docker image rm*": "ask",
      "kubectl delete*": "ask",
      "kubectl apply*": "ask",
      "helm delete*": "ask",
      "helm uninstall*": "ask",
      "terraform destroy*": "ask",
      "terraform apply*": "ask",

      "systemctl stop*": "ask",
      "systemctl disable*": "ask",
      "systemctl restart*": "ask",
      "launchctl unload*": "ask",
      "launchctl stop*": "ask",
      "brew services stop*": "ask",
      "brew services restart*": "ask",

      "psql -c DROP*": "ask",
      "psql -c DELETE*": "ask",
      "psql -c TRUNCATE*": "ask",
      "mysql -e DROP*": "ask",
      "mysql -e DELETE*": "ask",
      "mysql -e TRUNCATE*": "ask",
      "mongo --eval*drop*": "ask",
      "redis-cli FLUSHDB*": "ask",
      "redis-cli FLUSHALL*": "ask"
    }
  }
}
